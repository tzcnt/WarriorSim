[Unit]
Description=WarriorSim headless compute donor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/github/WarriorSim
ExecStart=/usr/bin/node %h/github/WarriorSim/compute/index.js
EnvironmentFile=-%h/.config/warriorsim-compute.env
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=control-group
Nice=10

[Install]
WantedBy=default.target
